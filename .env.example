# ═══════════════════════════════════════════════════════════
# SMS Gateway — Variáveis de ambiente (EasyPanel / Produção)
# Copie para .env no EasyPanel (Environment) ou ficheiro local
# ═══════════════════════════════════════════════════════════

# ── Base de dados MySQL ───────────────────────────────────
# Compose: não precisa definir DB_HOST (usa "db" automaticamente)
# DB_HOST=db
DB_NAME=smsgateway
DB_USER=smsuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ── Aplicação ─────────────────────────────────────────────
# Stack PHP/Docker: porta exposta no host (compose mapeia HTTP_PORT:80)
HTTP_PORT=8081

# URL pública do painel (com https), ex: https://sms.seudominio.com
# A porta na URL deve coincidir com HTTP_PORT (PHP) ou PORT (Next.js web/)
APP_URL=https://sms.seudominio.com

# Stack Next.js (web/): use PORT + APP_HOST no ficheiro web/.env
# PORT=3005
# APP_HOST=192.168.1.100

# Chave para migração automática no arranque (gere uma string aleatória)
MIGRATE_KEY=CHANGE_ME_RANDOM_SECRET

# Segredo HMAC para links/QR de pareamento (opcional; usa MIGRATE_KEY se vazio)
PAIRING_SECRET=CHANGE_ME_PAIRING_SECRET
MIGRATE_ON_START=true

# Timezone PHP
TZ=Europe/Lisbon

# ── phpMyAdmin (opcional, profile admin) ───────────────────
PMA_USER=smsuser
PMA_PASSWORD=CHANGE_ME_STRONG_PASSWORD