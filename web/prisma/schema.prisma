// SMS Gateway — Prisma schema (SQLite → Postgres/Supabase)
//
// SQLite (dev / single-node EasyPanel):
//   DATABASE_URL="file:./data/smsgateway.db"
//
// Supabase / Postgres (produção SaaS):
//   1. Altere provider para "postgresql"
//   2. DATABASE_URL="postgresql://postgres:...@db.xxx.supabase.co:5432/postgres"
//   3. prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum SmsQueueStatus {
  pending
  sent
  failed
}

enum WebhookDeliveryStatus {
  sent
  failed
}

model User {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String    @unique
  password              String
  apiKey                String?   @unique @map("api_key")
  role                  UserRole  @default(user)
  isActive              Boolean   @default(false) @map("is_active")
  webhookEnabled        Boolean   @default(false) @map("webhook_enabled")
  webhookUrl            String?   @map("webhook_url")
  webhookApiKey         String?   @map("webhook_api_key")
  webhookAuto           Boolean   @default(false) @map("webhook_auto")
  privacyConsentAt      DateTime? @map("privacy_consent_at")
  privacyConsentVersion String?   @map("privacy_consent_version")
  termsConsentAt        DateTime? @map("terms_consent_at")
  termsConsentVersion   String?   @map("terms_consent_version")
  createdAt             DateTime  @default(now()) @map("created_at")

  devices     Device[]
  smsReceived SmsReceived[]
  smsQueue    SmsQueue[]

  @@map("users")
}

model Device {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  deviceToken    String?   @unique @map("device_token")
  pairingCode    String?   @unique @map("pairing_code")
  pairingExpires DateTime? @map("pairing_expires")
  deviceName     String    @default("Android") @map("device_name")
  deviceHash     String?   @unique @map("device_hash")
  phoneNumber    String    @default("") @map("phone_number")
  lastSeen       DateTime? @map("last_seen")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsReceived SmsReceived[]
  smsQueue    SmsQueue[]

  @@index([userId])
  @@map("user_devices")
}

model SmsReceived {
  id                Int                    @id @default(autoincrement())
  userId            Int?                   @map("user_id")
  deviceId          Int?                   @map("device_id")
  userLabel         String                 @default("") @map("legacy_user")
  phoneNum          String                 @map("phone_num")
  message           String
  datestamp         DateTime               @default(now())
  dateSent          DateTime               @default(now()) @map("date_sent")
  recordStamp       DateTime               @default(now()) @map("record_stamp")
  webhookLastSent   DateTime?              @map("webhook_last_sent")
  webhookLastStatus WebhookDeliveryStatus? @map("webhook_last_status")
  webhookLastError  String?                @map("webhook_last_error")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([phoneNum])
  @@map("sms_received")
}

model SystemSettings {
  id                 Int      @id @default(1)
  publicUrl          String   @default("") @map("public_url")
  companyName        String   @default("") @map("company_name")
  dpoEmail           String   @default("") @map("dpo_email")
  address            String   @default("")
  country            String   @default("")
  taxId              String   @default("") @map("tax_id")
  legalRepresentative String  @default("") @map("legal_representative")
  jurisdiction       String   @default("")
  privacyPhone       String   @default("") @map("privacy_phone")
  legalVersion       String   @default("1.0") @map("legal_version")
  legalLastUpdated   String   @default("") @map("legal_last_updated")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model WaitlistEntry {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String    @default("")
  company        String    @default("")
  useCase        String    @default("") @map("use_case")
  consentAt      DateTime? @map("consent_at")
  consentVersion String?   @map("consent_version")
  ipHash         String?   @map("ip_hash")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("waitlist")
}

model ConsentRecord {
  id          Int      @id @default(autoincrement())
  subjectType String   @map("subject_type")
  subjectId   Int?     @map("subject_id")
  email       String?
  consentType String   @map("consent_type")
  version     String
  granted     Boolean  @default(true)
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([subjectType, subjectId])
  @@map("consent_records")
}

model DataRequest {
  id          Int       @id @default(autoincrement())
  type        String
  email       String?
  userId      Int?      @map("user_id")
  status      String    @default("completed")
  ipHash      String?   @map("ip_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([email])
  @@index([userId])
  @@map("data_requests")
}

model SmsQueue {
  id        Int            @id @default(autoincrement())
  userId    Int?           @map("user_id")
  deviceId  Int?           @map("device_id")
  phone     String
  message   String
  status    SmsQueueStatus @default(pending)
  createdAt DateTime       @default(now()) @map("created_at")
  sentAt    DateTime?      @map("sent_at")
  errorMsg  String?        @map("error_msg")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("sms_queue")
}