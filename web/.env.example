# SQLite (single-node / EasyPanel)
DATABASE_URL="file:./data/smsgateway.db"

# ── Portas e URL pública (QR, APK, Android) ─────────────────
PORT=3005
HOSTNAME=0.0.0.0

# IP LAN do PC (telefone na mesma WiFi). QR usa http://APP_HOST:PORT
APP_HOST=192.168.1.100

# Opcional: URL completa. Se definida, a porta DEVE coincidir com PORT.
# APP_URL=http://192.168.1.100:3005

NODE_ENV=development

MIGRATE_KEY=setup2026
PAIRING_SECRET=change_me_pairing_secret
SESSION_SECRET=change_me_session_secret

# Recuperação de emergência da palavra-passe do administrador (mín. 24 caracteres).
# Guarde num gestor de palavras-passe; nunca commite o valor real.
# ADMIN_RECOVERY_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32_CHARS_MIN

# Import MySQL → SQLite (scripts/import-from-mysql.ts)
# MYSQL_URL=mysql://smsuser:pass@127.0.0.1:3306/smsgateway

# Supabase (futuro)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@..."