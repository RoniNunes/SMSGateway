# Cole no Environment do EasyPanel (serviço Compose "web")
# Gere segredos: .\scripts\prepare-easypanel-web.ps1 -AppUrl "https://sms.seudominio.com"

PORT=80
APP_URL=https://sms.seudominio.com
DATABASE_URL=file:/data/smsgateway.db

MIGRATE_KEY=CHANGE_ME_RANDOM_SECRET
PAIRING_SECRET=CHANGE_ME_PAIRING_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
ADMIN_RECOVERY_SECRET=CHANGE_ME_ADMIN_RECOVERY_SECRET

TZ=Europe/Lisbon
NODE_ENV=production

# Legal / privacy — valores iniciais (editáveis no painel Admin → Sistema)
LEGAL_COMPANY_NAME=Evo Go SMS Gateway
LEGAL_DPO_EMAIL=privacy@evo-go.com
LEGAL_ADDRESS=
LEGAL_COUNTRY=Portugal
LEGAL_TAX_ID=
LEGAL_REPRESENTATIVE=
# Use apenas ASCII no .env do EasyPanel (evita problemas de encoding). Acentos podem ser editados no painel Admin -> Sistema.
LEGAL_JURISDICTION=Uniao Europeia, Brasil e jurisdicoes aplicaveis
LEGAL_PRIVACY_PHONE=